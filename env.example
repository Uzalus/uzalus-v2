# UZALUS Environment Variables
# Copy this file to .env.local and fill in your values

# CJ Dropshipping API Credentials
CJ_API_KEY=your_cj_api_key_here
CJ_EMAIL=your_cj_email_here

# OpenAI API Key (for Chat Widget AI)
OPENAI_API_KEY=your_openai_key_here

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Site URL
NEXT_PUBLIC_SITE_URL=https://uzalus.com
